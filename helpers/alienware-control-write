#!/usr/bin/python3 -I
# Alienware Control: change one supported BIOS setting.
# Runs as root through pkexec (asks for the admin password). Only known settings and
# only values the BIOS itself lists as valid are accepted.
#
#   alienware-control-write bios <Attribute> <Value>
import os
import re
import sys

BASE = "/sys/class/firmware-attributes/dell-wmi-sysman/attributes"
ENUMS = ("AWThermalManagement", "PrimaryBattChargeCfg", "TurboMode")
INTS = ("CustomChargeStart", "CustomChargeStop")
MIN_GAP = 5  # the charge stop level must stay at least 5 points above the start level


def fail(msg):
    print(msg, file=sys.stderr)
    sys.exit(2)


def read(path):
    with open(path) as f:
        return f.read().strip()


args = sys.argv[1:]
if len(args) != 3 or args[0] != "bios":
    fail("usage: alienware-control-write bios <Attribute> <Value>")

name, value = args[1], args[2]
d = os.path.join(BASE, name)

try:
    if name in ENUMS:
        allowed = [v for v in read(os.path.join(d, "possible_values")).split(";") if v]
        if value not in allowed:
            fail(f"'{value}' is not a valid value for {name}: {allowed}")
    elif name in INTS:
        if not re.fullmatch(r"[0-9]{1,3}", value):
            fail("the value must be a whole number")
        lo, hi, n = int(read(os.path.join(d, "min_value"))), int(read(os.path.join(d, "max_value"))), int(value)
        if not lo <= n <= hi:
            fail(f"{name} must be between {lo} and {hi}")
        if name == "CustomChargeStart":
            stop = int(read(os.path.join(BASE, "CustomChargeStop", "current_value")))
            if n > stop - MIN_GAP:
                fail(f"start ({n}) must be at most {stop - MIN_GAP} (current stop is {stop})")
        else:
            start = int(read(os.path.join(BASE, "CustomChargeStart", "current_value")))
            if n < start + MIN_GAP:
                fail(f"stop ({n}) must be at least {start + MIN_GAP} (current start is {start})")
    else:
        fail(f"unknown setting: {name}")

    if read(os.path.join(d, "current_value")) != value:
        with open(os.path.join(d, "current_value"), "w") as f:
            f.write(value)
except (OSError, ValueError) as e:
    fail(f"this BIOS setting is not available or is locked (BIOS admin password?): {e.__class__.__name__}")
