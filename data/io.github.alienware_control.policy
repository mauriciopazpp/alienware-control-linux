<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Alienware Control</vendor>
  <action id="io.github.alienware_control.read">
    <description>Read Alienware BIOS settings</description>
    <message>Alienware Control wants to read the BIOS settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/alienware-control-read</annotate>
  </action>
  <action id="io.github.alienware_control.write">
    <description>Change Alienware BIOS settings</description>
    <message>Authentication is required to change an Alienware BIOS setting</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/alienware-control-write</annotate>
  </action>
</policyconfig>
