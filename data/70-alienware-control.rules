# Alienware Control: let the logged-in user drive the lighting controllers.
# Must sort before 73-seat-late.rules, which turns the "uaccess" tag into an ACL.

# AW-ELC lighting controller (power button, lid logo)
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="187c", ATTRS{idProduct}=="0550", ATTRS{bInterfaceNumber}=="00", TAG+="uaccess"
# Per-key RGB keyboard (Darfon) used by recent Alienware laptops
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0d62", ATTRS{idProduct}=="dabc", ATTRS{bInterfaceNumber}=="00", TAG+="uaccess"
